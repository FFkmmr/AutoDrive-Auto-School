# Django core
SECRET_KEY=your-secret-key-here
DEBUG=1

# Frontend-only mode: set to 1 to disable email sending (forms return success silently)
# Use this locally when Mailgun is not configured
FRONTEND_ONLY=1

# Database (leave empty to use SQLite locally)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Mailgun (required in production, ignored when FRONTEND_ONLY=1)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=AutoDrive <no-reply@yourdomain.com>
MAILGUN_TO=admin@yourdomain.com
